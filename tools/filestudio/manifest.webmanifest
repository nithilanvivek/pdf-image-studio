{
  "id": "/tools/filestudio/",
  "name": "PDF + Image Studio",
  "short_name": "PDF + Image Studio",
  "description": "Private PDF and image tools with browser processing and automatic server fallback.",
  "start_url": "/tools/filestudio/",
  "scope": "/tools/filestudio/",
  "display": "standalone",
  "background_color": "#f7f5f0",
  "theme_color": "#f4f1eb",
  "icons": [
    { "src": "icons/icon-192.png?v=4", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-1024.png?v=4", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-1024.png?v=4", "sizes": "1024x1024", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{
    "action": "/tools/filestudio/",
    "name": "Open with PDF + Image Studio",
    "launch_type": "single-client",
    "accept": {
      "application/pdf": [".pdf"],
      "image/png": [".png"],
      "image/jpeg": [".jpg", ".jpeg"],
      "image/webp": [".webp"],
      "image/tiff": [".tif", ".tiff"],
      "image/gif": [".gif"],
      "image/bmp": [".bmp"]
    }
  }],
  "launch_handler": { "client_mode": "focus-existing" },
  "categories": ["productivity", "utilities", "photo"]
}
